{
  "name": "paper-preflight",
  "version": "0.1.0",
  "description": "Check a conference submission PDF (anonymity, fonts, page limit, unresolved references) entirely in your browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "python3 scripts/make_fixtures.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
